# Copiá este archivo como .env.local (desarrollo) y cargá los mismos valores en Vercel (producción).

# --- Supabase (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_. La usan las rutas /api (subidas, borrados, admin).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Administración ---
# Clave para entrar a /admin y /admin/comercios. Mínimo 12 caracteres; usá una larga y aleatoria.
# Solo servidor. NUNCA con prefijo NEXT_PUBLIC_.
ADMIN_API_KEY=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://mascotastrelew.vercel.app
# Provincia por defecto cuando no se puede detectar (slug de src/config/regions.generated.ts)
NEXT_PUBLIC_DEFAULT_REGION=chubut

# --- Comercios Amigos (opcionales) ---
NEXT_PUBLIC_PARTNER_CONTACT_WHATSAPP=
NEXT_PUBLIC_PARTNER_CONTACT_EMAIL=

# --- Emails (Resend: https://resend.com) ---
# Clave de API de Resend (re_...). Solo servidor.
RESEND_API_KEY=
# Remitente. El dominio tiene que estar verificado en Resend (Domains).
# Sin dominio propio, Resend solo deja enviarte mails a vos mismo (para probar) desde onboarding@resend.dev
EMAIL_FROM=Mascotas Perdidas <avisos@tudominio.com.ar>

# --- Captcha anti-spam (Cloudflare Turnstile: dash.cloudflare.com > Turnstile) ---
# Site Key: pública, va en el navegador.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret Key: SOLO servidor (nunca con NEXT_PUBLIC_ ni en el chat/repositorio).
# Si queda vacía, el captcha no se exige (útil en desarrollo).
TURNSTILE_SECRET_KEY=
